// Definition for the devcontainer used by GitHub Codespaces.
{
  "name": "Full-stack devcontainer (Backend & Frontend)",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "WORKSPACE": "${containerWorkspaceFolder}"
    }
  },
  "mounts": [
    "source=uv-cache-${devcontainerId},target=/home/vscode/.cache/uv,type=volume",
    "source=api-venv-${devcontainerId},target=${containerWorkspaceFolder}/api/.venv,type=volume",
    "source=node-modules-${devcontainerId},target=${containerWorkspaceFolder}/web/node_modules,type=volume"
  ],
  "forwardPorts": [80],
  "portsAttributes": {
    "80": {
      "label": "Mercury",
      "onAutoForward": "openBrowser",
      "requireLocalPort": true
    }
  },
  "remoteEnv": {
    "COMPOSE_BAKE": "true"
  },
  "postAttachCommand": {
    "setup": "mise trust --yes && mise run setup"
  },
  "features": {
    "ghcr.io/devcontainers/features/azure-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4": { "moby": false }
  },
  "customizations": {
    "vscode": {
      "settings": {
        // Set formatter for specific filetypes and enable format on save
        "[toml]": {
          "editor.defaultFormatter": "tamasfe.even-better-toml",
          "editor.formatOnSave": true
        },
        "[json][jsonc]": {
          "editor.defaultFormatter": "biomejs.biome",
          "editor.formatOnSave": true
        },
        "[dockercompose]": {
          "editor.defaultFormatter": "ms-azuretools.vscode-containers",
          "editor.formatOnSave": true
        },
        "[github-actions-workflow][github-workflow][yaml]": {
          "editor.defaultFormatter": "redhat.vscode-yaml",
          "editor.formatOnSave": true
        },
        "[python]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit",
            "source.fixAll": "explicit"
          }
        },
        "[typescriptreact][typescript][javascript][javascriptreact][css]": {
          "editor.formatOnSave": true,
          "editor.defaultFormatter": "biomejs.biome",
          "editor.codeActionsOnSave": {
            "source.organizeImports.biome": "explicit",
            "source.fixAll.biome": "explicit"
          }
        },
        // Python specific settings
        "python.defaultInterpreterPath": "${workspaceFolder}/api/.venv/bin/python",
        // Frontend specific settings
        "biome.requireConfiguration": true,
        "biome.lsp.bin": "web/node_modules/@biomejs/biome/bin/biome",
        "biome.configPath": "${workspaceFolder}/biome.json",
        "git.terminalAuthentication": true
      },
      // Extensions that is handy to have in the devcontainer
      "extensions": [
        "biomejs.biome",
        "charliermarsh.ruff",
        "astral-sh.ty",
        "ms-python.python",
        "tamasfe.even-better-toml",
        "docker.docker",
        "redhat.vscode-yaml",
        "eamodio.gitlens",
        "ms-azuretools.vscode-containers",
        "streetsidesoftware.code-spell-checker",
        "streetsidesoftware.code-spell-checker-norwegian-bokmal",
        "streetsidesoftware.code-spell-checker-scientific-terms",
        "github.vscode-github-actions",
        "DavidAnson.vscode-markdownlint",
        "ms-azuretools.vscode-bicep",
        "vitest.explorer",
        "hverlin.mise-vscode",
        "codeandstuff.package-json-upgrade"
      ]
    }
  }
}
